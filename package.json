  "bugs": {
    "url": "https://github.com/strongloop/loopback-connector-remote/issues"
  },
  "homepage": "http://loopback.io",
  "dependencies": {
    "loopback-datasource-juggler": "github:perkd/loopback-datasource-juggler#semver:^6.0.0",
    "strong-remoting": "github:perkd/strong-remoting#semver:^3.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "loopback": "github:perkd/loopback#semver:^3.36.1",
