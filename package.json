{
  "name": "@perkd/loopback-connector-remote",
  "version": "3.6.0",
  "description": "Remote REST API connector for Loopback",
  "author": "IBM Corp.",
  "main": "lib/remote-connector.js",
  "keywords": [
    "web",
    "restful",
    "rest",
    "StrongLoop"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-force-exit --test-reporter=spec --experimental-test-coverage 'test/*.test.js' 'test/integration/*.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "reinstall": "rm -rf node_modules yarn.lock && yarn install"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/perkd/loopback-connector-remote.git"
  },
  "contributors": [
    "Ritchie Martori <skawful@gmail.com> (https://github.com/ritch)",
    "Krishna Raman <kraman@gmail.com> (https://github.com/kraman)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/perkd/loopback-connector-remote/issues"
  },
  "homepage": "https://github.com/perkd/loopback-connector-remote#readme",
  "dependencies": {
    "loopback-datasource-juggler": "npm:@perkd/loopback-datasource-juggler@^6.1.0",
    "strong-remoting": "npm:@perkd/strong-remoting@^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "sinon": "^22.0.0",
    "strong-task-emitter": "^0.0.8"
  },
  "packageManager": "yarn@4.17.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "index.js",
    "lib",
    "README.md"
  ]
}
